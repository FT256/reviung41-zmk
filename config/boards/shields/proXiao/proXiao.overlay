#include "arduino_pro_micro_pins.dtsi"

/ {
	chosen {
        zmk,connector = &pro_micro;
	};

    nc_gpio: dummy_gpio {
        compatible = "fixed-gpio"; /* dummy */
        status = "disabled";
    };

};
&xiao_spi { status = "disabled"; };
&xiao_i2c { status = "disabled"; };
&xiao_serial { status = "disabled"; };

